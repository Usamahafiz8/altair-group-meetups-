# Copy to .env and fill in from your hosted Supabase project
# (Project Settings -> API, and Project Settings -> Database).
# .env is gitignored. Never paste these values into chat or commit them.

# --- Supabase project ---
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Server-side / test-setup only. NEVER put this in the app.
SUPABASE_SERVICE_ROLE_KEY=
# Used by `supabase db push`.
SUPABASE_DB_PASSWORD=
# Server-side only (write endpoint + test setup). URL-encode special characters in
# the password (e.g. @ -> %40). If the direct host is unreachable (IPv6-only), use the
# Session pooler string from Project Settings -> Database -> Connect.
DATABASE_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres

# --- Write endpoint server ---
API_PORT=8787

# --- Expo app (only EXPO_PUBLIC_* values are bundled into the app) ---
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Android emulator reaches the host machine at 10.0.2.2
EXPO_PUBLIC_API_URL=http://10.0.2.2:8787
