# Copy to .env (gitignored) and fill in from your Supabase project.
# Never commit .env or paste its values anywhere.

# Project Settings -> API (or Connect)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Server-side only: the endpoint server, the DB scripts and the tests use it.
# Use the "Session pooler" connection string (Connect -> Session pooler): the direct
# db.<ref>.supabase.co host is IPv6-only on the free tier. URL-encode the password
# (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Endpoint server
API_PORT=8787

# Expo app: only EXPO_PUBLIC_* values are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Android emulator reaches the host at 10.0.2.2; on a physical device use your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8787
